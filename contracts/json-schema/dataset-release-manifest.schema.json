{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vfbiz.example/contracts/dataset-release-manifest/v1",
  "title": "Dataset Release Manifest",
  "type": "object",
  "required": ["releaseId", "datasetId", "revision", "profile", "classification", "sourceEntries", "contentHash", "embedding", "approvals", "createdAt"],
  "properties": {
    "releaseId": {"type": "string", "minLength": 1},
    "datasetId": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "profile": {"enum": ["public_customer", "authenticated_customer", "employee"]},
    "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "sourceEntries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "contentHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "embedding": {
      "type": "object",
      "required": ["provider", "model", "dimensions"],
      "properties": {
        "provider": {"type": "string"},
        "model": {"type": "string"},
        "dimensions": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "retentionPolicy": {"type": "string"},
    "tombstoneRevision": {"type": ["string", "null"]},
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "decision", "decidedAt"],
        "properties": {
          "role": {"enum": ["data-owner", "privacy-owner", "legal-owner"]},
          "decision": {"enum": ["approved", "rejected"]},
          "decidedAt": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": false
      }
    },
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
