{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vfbiz.example/contracts/ai/evaluation/grader-definition/v2",
  "title": "VFBiz AI Grader Definition",
  "type": "object",
  "required": [
    "calibration_required",
    "definition_digest",
    "implementation_digest",
    "kind",
    "revision"
  ],
  "properties": {
    "calibration_required": { "type": "boolean" },
    "definition_digest": { "$ref": "#/$defs/sha256" },
    "implementation_digest": { "$ref": "#/$defs/sha256" },
    "kind": {
      "enum": ["deterministic", "citation", "nli", "model-judge", "human"]
    },
    "revision": { "type": "string", "minLength": 1, "maxLength": 200 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "enum": ["nli", "model-judge"] } },
        "required": ["kind"]
      },
      "then": { "properties": { "calibration_required": { "const": true } } }
    }
  ],
  "additionalProperties": false
}
