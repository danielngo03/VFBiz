{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vfbiz.example/contracts/ai/evaluation/grader-definition/v1",
  "title": "VFBiz AI Grader Definition",
  "type": "object",
  "required": [
    "grader_id",
    "revision",
    "kind",
    "evaluation_claims",
    "input_contract_digest",
    "output_contract_digest",
    "calibration_required",
    "definition_digest"
  ],
  "properties": {
    "grader_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "revision": { "type": "string", "minLength": 1, "maxLength": 200 },
    "kind": {
      "enum": ["deterministic", "citation", "nli", "model-judge", "human"]
    },
    "evaluation_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "input_contract_digest": { "$ref": "#/$defs/sha256" },
    "output_contract_digest": { "$ref": "#/$defs/sha256" },
    "calibration_required": { "type": "boolean" },
    "definition_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "enum": ["nli", "model-judge"] } },
        "required": ["kind"]
      },
      "then": { "properties": { "calibration_required": { "const": true } } }
    }
  ],
  "additionalProperties": false
}
