{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vfbiz.example/contracts/ai/evaluation/run-request/v1",
  "title": "VFBiz AI Evaluation Run Request",
  "type": "object",
  "required": [
    "run_id",
    "evaluation_claim",
    "subject_under_test",
    "candidate_release",
    "baseline_release",
    "suite_revision",
    "runner_image_digest",
    "harness_revision",
    "tool_simulator_revision",
    "grader_revisions",
    "environment_revision",
    "random_seed",
    "budgets",
    "attempt_policy",
    "requested_at",
    "request_digest"
  ],
  "properties": {
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{3,160}$" },
    "evaluation_claim": { "type": "string", "minLength": 8, "maxLength": 1000 },
    "subject_under_test": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "candidate_release": { "$ref": "#/$defs/release" },
    "baseline_release": {
      "oneOf": [{ "$ref": "#/$defs/release" }, { "type": "null" }]
    },
    "suite_revision": { "$ref": "#/$defs/suite" },
    "runner_image_digest": { "$ref": "#/$defs/sha256" },
    "harness_revision": { "type": "string", "minLength": 1, "maxLength": 200 },
    "tool_simulator_revision": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200
    },
    "grader_revisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "environment_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "random_seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "budgets": {
      "type": "object",
      "required": [
        "max_input_tokens",
        "max_output_tokens",
        "max_duration_seconds",
        "max_cost_usd"
      ],
      "properties": {
        "max_input_tokens": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "max_duration_seconds": { "type": "integer", "minimum": 1 },
        "max_cost_usd": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "attempt_policy": {
      "type": "object",
      "required": ["max_attempts", "retryable_failure_codes"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "retryable_failure_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "runner-unavailable",
              "provider-timeout",
              "artifact-store-unavailable"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "requested_at": { "type": "string", "format": "date-time" },
    "request_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "release": {
      "type": "object",
      "required": ["release_id", "manifest_digest"],
      "properties": {
        "release_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "manifest_digest": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "suite": {
      "type": "object",
      "required": ["suite_id", "suite_digest"],
      "properties": {
        "suite_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "suite_digest": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
