{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vfbiz.example/contracts/ai/evaluation/run-request/v2",
  "title": "VFBiz AI Evaluation Resolved Run Request",
  "type": "object",
  "required": [
    "runId",
    "evaluationClaim",
    "subjectUnderTest",
    "authorityClass",
    "candidate",
    "baseline",
    "benchmarkDefinitionDigest",
    "baselinePolicyDigest",
    "suite",
    "runnerImageDigest",
    "harnessRevision",
    "toolSimulatorRevision",
    "metricRevisions",
    "graderRevisions",
    "graderKinds",
    "graderCalibrations",
    "environmentRevision",
    "randomSeed",
    "budgets",
    "attemptPolicy",
    "requestedAt",
    "requestDigest"
  ],
  "properties": {
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{3,160}$" },
    "evaluationClaim": { "type": "string", "minLength": 8, "maxLength": 1000 },
    "subjectUnderTest": { "type": "string", "minLength": 1, "maxLength": 200 },
    "authorityClass": {
      "enum": ["vinfast-acceptance", "public-diagnostic"]
    },
    "candidate": { "$ref": "#/$defs/release" },
    "baseline": {
      "oneOf": [{ "$ref": "#/$defs/release" }, { "type": "null" }]
    },
    "benchmarkDefinitionDigest": { "$ref": "#/$defs/sha256" },
    "baselinePolicyDigest": { "$ref": "#/$defs/sha256" },
    "suite": { "$ref": "#/$defs/suite" },
    "runnerImageDigest": { "$ref": "#/$defs/sha256" },
    "harnessRevision": { "type": "string", "minLength": 1, "maxLength": 200 },
    "toolSimulatorRevision": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200
    },
    "metricRevisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "graderRevisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "graderKinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "revision"],
        "properties": {
          "kind": {
            "enum": ["deterministic", "citation", "nli", "model-judge", "human"]
          },
          "revision": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "additionalProperties": false
      }
    },
    "graderCalibrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "calibrationDigest",
          "definitionDigest",
          "graderRevision",
          "implementationDigest",
          "humanLabelledSuiteDigest",
          "calibratedAt",
          "expiresAt"
        ],
        "properties": {
          "calibrationDigest": { "$ref": "#/$defs/sha256" },
          "definitionDigest": { "$ref": "#/$defs/sha256" },
          "graderRevision": { "type": "string", "minLength": 1, "maxLength": 200 },
          "implementationDigest": { "$ref": "#/$defs/sha256" },
          "humanLabelledSuiteDigest": { "$ref": "#/$defs/sha256" },
          "calibratedAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "environmentRevision": { "type": "string", "minLength": 1, "maxLength": 200 },
    "randomSeed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "budgets": {
      "type": "object",
      "required": [
        "maxInputTokens",
        "maxOutputTokens",
        "maxDurationSeconds",
        "maxCostUsd"
      ],
      "properties": {
        "maxInputTokens": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxDurationSeconds": { "type": "integer", "minimum": 1, "maximum": 2147483 },
        "maxCostUsd": { "type": "number", "minimum": 0, "maximum": 1000000 }
      },
      "additionalProperties": false
    },
    "attemptPolicy": {
      "type": "object",
      "required": ["maxAttempts", "retryableFailureCodes"],
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "retryableFailureCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "runner-unavailable",
              "provider-timeout",
              "artifact-store-unavailable"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "requestedAt": { "type": "string", "format": "date-time" },
    "requestDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "release": {
      "type": "object",
      "required": ["releaseId", "manifestDigest"],
      "properties": {
        "releaseId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "manifestDigest": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "suite": {
      "type": "object",
      "required": ["id", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "digest": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
