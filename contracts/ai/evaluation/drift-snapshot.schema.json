{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vfbiz.example/contracts/ai/evaluation/drift-snapshot/v1",
  "title": "VFBiz AI Drift Snapshot",
  "type": "object",
  "required": [
    "snapshot_id",
    "release_id",
    "release_manifest_digest",
    "window_start",
    "window_end",
    "sample_policy_revision",
    "privacy_policy_digest",
    "slice_metrics",
    "alerts",
    "raw_customer_content_included",
    "snapshot_digest"
  ],
  "properties": {
    "snapshot_id": { "type": "string", "minLength": 3, "maxLength": 160 },
    "release_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "release_manifest_digest": { "$ref": "#/$defs/sha256" },
    "window_start": { "type": "string", "format": "date-time" },
    "window_end": { "type": "string", "format": "date-time" },
    "sample_policy_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "privacy_policy_digest": { "$ref": "#/$defs/sha256" },
    "slice_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "metric_revision",
          "slice",
          "sample_size",
          "value",
          "baseline_delta"
        ],
        "properties": {
          "metric_revision": { "type": "string", "minLength": 1 },
          "slice": { "type": "string", "minLength": 1 },
          "sample_size": { "type": "integer", "minimum": 1 },
          "value": { "type": "number" },
          "baseline_delta": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "metric_revision", "slice"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["info", "warning", "critical"] },
          "metric_revision": { "type": "string", "minLength": 1 },
          "slice": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "raw_customer_content_included": { "const": false },
    "snapshot_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
