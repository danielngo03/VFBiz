{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vfbiz.example/contracts/ai/evaluation/benchmark-definition/v2",
  "title": "VFBiz AI Benchmark Definition",
  "type": "object",
  "required": [
    "authority_class",
    "baseline_policy_digest",
    "benchmark_id",
    "budgets",
    "definition_digest",
    "environment_revision",
    "grader_revisions",
    "harness_revision",
    "max_attempts",
    "metric_revisions",
    "retryable_failure_codes",
    "revision",
    "runner_image_digest",
    "suite_digest",
    "suite_id",
    "tool_simulator_revision"
  ],
  "properties": {
    "authority_class": {
      "enum": ["vinfast-acceptance", "public-diagnostic"]
    },
    "baseline_policy_digest": { "$ref": "#/$defs/sha256" },
    "benchmark_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "budgets": {
      "type": "object",
      "required": [
        "max_cost_usd",
        "max_duration_seconds",
        "max_input_tokens",
        "max_output_tokens"
      ],
      "properties": {
        "max_cost_usd": { "type": "number", "minimum": 0, "maximum": 1000000 },
        "max_duration_seconds": { "type": "integer", "minimum": 1, "maximum": 2147483 },
        "max_input_tokens": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "max_output_tokens": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      },
      "additionalProperties": false
    },
    "definition_digest": { "$ref": "#/$defs/sha256" },
    "environment_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "grader_revisions": { "$ref": "#/$defs/revisions" },
    "harness_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "max_attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
    "metric_revisions": { "$ref": "#/$defs/revisions" },
    "retryable_failure_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "runner-unavailable",
          "provider-timeout",
          "artifact-store-unavailable"
        ]
      }
    },
    "revision": { "type": "string", "minLength": 1, "maxLength": 200 },
    "runner_image_digest": { "$ref": "#/$defs/sha256" },
    "suite_digest": { "$ref": "#/$defs/sha256" },
    "suite_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "tool_simulator_revision": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    }
  },
  "additionalProperties": false
}
