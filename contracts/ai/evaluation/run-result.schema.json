{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vfbiz.example/contracts/ai/evaluation/run-result/v1",
  "title": "VFBiz AI Evaluation Run Result",
  "type": "object",
  "required": [
    "run_id",
    "request_digest",
    "state",
    "case_results_digest",
    "case_counts",
    "metrics",
    "hard_gate_failures",
    "budget_usage",
    "started_at",
    "completed_at",
    "evidence_digest"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 3, "maxLength": 160 },
    "request_digest": { "$ref": "#/$defs/sha256" },
    "state": { "enum": ["decision_ready", "failed", "cancelled", "invalid"] },
    "case_results_digest": { "$ref": "#/$defs/sha256" },
    "case_counts": {
      "type": "object",
      "required": [
        "expected",
        "evaluated",
        "valid",
        "invalid",
        "failed",
        "cancelled"
      ],
      "properties": {
        "expected": { "type": "integer", "minimum": 1 },
        "evaluated": { "type": "integer", "minimum": 0 },
        "valid": { "type": "integer", "minimum": 0 },
        "invalid": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "cancelled": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metric_revision", "slice", "value", "sample_size"],
        "properties": {
          "metric_revision": { "type": "string", "minLength": 1 },
          "slice": { "type": "string", "minLength": 1 },
          "value": { "type": "number" },
          "sample_size": { "type": "integer", "minimum": 1 },
          "lower_95": { "type": ["number", "null"] },
          "upper_95": { "type": ["number", "null"] }
        },
        "additionalProperties": false
      }
    },
    "hard_gate_failures": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "budget_usage": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "duration_seconds",
        "cost_usd"
      ],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "duration_seconds": { "type": "number", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "evidence_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
