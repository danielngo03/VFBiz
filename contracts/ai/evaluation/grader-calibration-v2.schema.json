{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vfbiz.example/contracts/ai/evaluation/grader-calibration/v2",
  "title": "VFBiz AI Grader Calibration Evidence",
  "type": "object",
  "required": [
    "grader_revision",
    "grader_definition_digest",
    "implementation_digest",
    "human_labelled_suite_digest",
    "sample_size",
    "confusion_matrix",
    "balanced_accuracy",
    "f1",
    "slice_metrics",
    "calibrated_at",
    "expires_at",
    "evidence_digest"
  ],
  "properties": {
    "grader_revision": { "type": "string", "minLength": 1, "maxLength": 200 },
    "grader_definition_digest": { "$ref": "#/$defs/sha256" },
    "implementation_digest": { "$ref": "#/$defs/sha256" },
    "human_labelled_suite_digest": { "$ref": "#/$defs/sha256" },
    "sample_size": {
      "type": "integer",
      "minimum": 30,
      "maximum": 9007199254740991
    },
    "confusion_matrix": {
      "type": "object",
      "required": [
        "true_positive",
        "true_negative",
        "false_positive",
        "false_negative"
      ],
      "properties": {
        "true_positive": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "true_negative": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "false_positive": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "false_negative": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "additionalProperties": false
    },
    "balanced_accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
    "f1": { "type": "number", "minimum": 0, "maximum": 1 },
    "slice_metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "slice",
          "sample_size",
          "confusion_matrix",
          "balanced_accuracy",
          "f1"
        ],
        "properties": {
          "slice": { "type": "string", "minLength": 1 },
          "sample_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "confusion_matrix": { "$ref": "#/properties/confusion_matrix" },
          "balanced_accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
          "f1": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "calibrated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "evidence_digest": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "properties": {
        "slice_metrics": {
          "type": "array",
          "contains": {
            "type": "object",
            "properties": { "slice": { "const": "all" } },
            "required": ["slice"]
          }
        }
      }
    },
    {
      "properties": {
        "slice_metrics": {
          "type": "array",
          "contains": {
            "type": "object",
            "properties": { "slice": { "const": "high-risk" } },
            "required": ["slice"]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
