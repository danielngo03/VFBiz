{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vfbiz.example/contracts/ai/execution-assertion/v1",
  "title": "VFBiz AI Execution Assertion Claims",
  "description": "Claims payload carried only inside a short-lived signed JWS from the API Platform to the AI Platform.",
  "type": "object",
  "required": [
    "iss",
    "aud",
    "iat",
    "nbf",
    "exp",
    "jti",
    "action",
    "requestHash",
    "requestId",
    "correlationId",
    "sessionId",
    "turnId",
    "conversationVersion",
    "fencingToken",
    "assistantProfile",
    "authorizationContextDigest",
    "authorization",
    "locale",
    "budget",
    "policyRevision",
    "graphRevision",
    "knowledgeRevision",
    "activationId",
    "manifestSha256"
  ],
  "properties": {
    "iss": { "const": "vfbiz-api" },
    "aud": { "const": "vfbiz-ai" },
    "iat": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "nbf": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "exp": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "jti": { "type": "string", "format": "uuid" },
    "action": { "enum": ["turn.execute", "turn.cancel"] },
    "requestHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lower-case SHA-256 of UTF-8 UPPERCASE(method) + LF + exact received origin-form path bytes + LF + repository-canonical JSON. Signed operations forbid query parameters and floating-point numbers. Canonical JSON rejects duplicate keys, preserves Unicode without normalization, sorts the schema-defined ASCII member names lexicographically, emits integers in base-10 without leading zeros, uses JSON escaping only when required and has no insignificant whitespace. Both runtimes must execute the repository golden vectors."
    },
    "requestId": { "type": "string", "format": "uuid" },
    "correlationId": { "type": "string", "format": "uuid" },
    "sessionId": { "type": "string", "format": "uuid" },
    "turnId": { "type": "string", "format": "uuid" },
    "conversationVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "fencingToken": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "assistantProfile": {
      "enum": ["public_customer", "authenticated_customer"]
    },
    "authorizationContextDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Digest of the API-authoritative subject/capability context. It binds durable task state to the same authorization context as this signed execution."
    },
    "authorization": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "capabilityHash", "allowedTools"],
          "properties": {
            "kind": { "const": "public_capability" },
            "capabilityHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "allowedTools": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 1,
              "items": { "$ref": "#/$defs/PublicReadOnlyTool" }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "subjectRef", "scopes", "allowedTools"],
          "properties": {
            "kind": { "const": "authenticated_customer" },
            "subjectRef": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "scopes": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "allowedTools": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 5,
              "items": { "$ref": "#/$defs/ReadOnlyTool" }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "locale": { "enum": ["vi", "en"] },
    "budget": {
      "type": "object",
      "required": ["maxModelTokens", "maxCostMicros", "deadlineAt"],
      "properties": {
        "maxModelTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32000
        },
        "maxCostMicros": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "deadlineAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "policyRevision": { "type": "string", "minLength": 1, "maxLength": 160 },
    "graphRevision": { "type": "string", "minLength": 1, "maxLength": 160 },
    "knowledgeRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "Atomically active knowledge snapshot for production turns; candidate revisions are forbidden outside evaluation or simulator contexts."
    },
    "activationId": { "type": "string", "format": "uuid" },
    "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "assistantProfile": { "const": "public_customer" }
        },
        "required": ["assistantProfile"]
      },
      "then": {
        "properties": {
          "authorization": {
            "type": "object",
            "properties": { "kind": { "const": "public_capability" } },
            "required": ["kind"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assistantProfile": { "const": "authenticated_customer" }
        },
        "required": ["assistantProfile"]
      },
      "then": {
        "properties": {
          "authorization": {
            "type": "object",
            "properties": {
              "kind": { "const": "authenticated_customer" }
            },
            "required": ["kind"]
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "PublicReadOnlyTool": {
      "enum": ["search_public_knowledge"]
    },
    "ReadOnlyTool": {
      "enum": [
        "search_public_knowledge",
        "get_vehicle_profile",
        "get_customer_garage",
        "list_charging_stations"
      ]
    }
  }
}
