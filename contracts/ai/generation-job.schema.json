{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vfbiz.example/contracts/ai/generation-job/v1",
  "title": "VFBiz Synthetic Dataset Generation Job",
  "type": "object",
  "required": [
    "job_id",
    "dataset_id",
    "purpose",
    "assistant_profile",
    "schema_revision",
    "seed_refs",
    "generator",
    "budget",
    "coverage",
    "shard",
    "prohibited_inputs",
    "status"
  ],
  "properties": {
    "job_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "dataset_id": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "assistant_profile": {
      "enum": ["public_customer", "authenticated_customer"]
    },
    "schema_revision": { "type": "string", "minLength": 1 },
    "seed_refs": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "approved_source_refs": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "synthetic_fact_namespaces": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "generator": {
      "type": "object",
      "required": [
        "model_revision",
        "prompt_revision",
        "policy_revision",
        "temperature",
        "seed"
      ],
      "properties": {
        "model_revision": { "type": "string", "minLength": 1 },
        "prompt_revision": { "type": "string", "minLength": 1 },
        "policy_revision": { "type": "string", "minLength": 1 },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "seed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": [
        "max_records",
        "max_input_tokens",
        "max_output_tokens",
        "max_cost_usd"
      ],
      "properties": {
        "max_records": { "type": "integer", "minimum": 1, "maximum": 30000 },
        "max_input_tokens": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "max_cost_usd": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "coverage": { "type": "object", "minProperties": 1 },
    "shard": {
      "type": "object",
      "required": ["shard_id", "output_prefix", "lease_id"],
      "properties": {
        "shard_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "output_prefix": { "type": "string", "minLength": 1 },
        "lease_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "prohibited_inputs": {
      "type": "array",
      "items": {
        "enum": [
          "production-pii",
          "customer-chat",
          "held-out-evaluation",
          "unapproved-source"
        ]
      },
      "contains": { "const": "production-pii" },
      "uniqueItems": true
    },
    "status": {
      "enum": ["approved", "running", "completed", "failed", "cancelled"]
    }
  },
  "additionalProperties": false
}
