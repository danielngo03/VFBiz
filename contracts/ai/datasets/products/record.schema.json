{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vfbiz.example/contracts/ai/dataset-record/v2",
  "title": "ViVi Canonical Dataset Record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "asset_kind",
    "allowed_use",
    "task_families",
    "modalities",
    "trust_zone",
    "processing_stage",
    "split_role",
    "split_family_id",
    "locale",
    "payload_schema_id",
    "payload_schema_revision",
    "payload",
    "lineage"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "asset_kind": {
      "enum": ["source-document", "dataset-record", "evaluation-case", "synthetic-candidate"]
    },
    "allowed_use": {
      "enum": [
        "knowledge-index",
        "classifier-training",
        "sft",
        "preference",
        "embedding",
        "reranker",
        "evaluation",
        "red-team"
      ]
    },
    "task_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "factual-citation",
          "retrieval",
          "intent-ood",
          "conversation-quality",
          "tool-use",
          "refusal-safety",
          "state-resilience"
        ]
      }
    },
    "modalities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["text", "document", "image", "audio"]}
    },
    "trust_zone": {
      "enum": [
        "quarantine",
        "candidate",
        "released",
        "restricted-evaluation",
        "red-team"
      ]
    },
    "processing_stage": {
      "enum": ["raw", "normalized", "filtered", "enriched", "adjudicated"]
    },
    "split_role": {"enum": ["train", "validation", "test", "golden", "red-team"]},
    "split_family_id": {"type": "string", "minLength": 1},
    "locale": {"type": "string", "minLength": 2},
    "payload_schema_id": {
      "enum": [
        "vivi-conversation",
        "vivi-preference",
        "vivi-tool",
        "vivi-embedding",
        "vivi-reranker",
        "vivi-classifier",
        "vivi-evaluation"
      ]
    },
    "payload_schema_revision": {"type": "string", "minLength": 1},
    "payload": {"type": "object", "minProperties": 1},
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_revision",
        "source_record_id",
        "source_content_sha256",
        "parent_artifact_sha256",
        "transformation_ids",
        "transformation_graph_sha256",
        "contamination_fingerprint"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "source_record_id": {"type": "string", "minLength": 1},
        "source_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "parent_artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "transformation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "transformation_graph_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contamination_fingerprint": {
          "type": "string",
          "pattern": "^(?:sha256|minhash-v[0-9]+):[A-Za-z0-9._:-]+$"
        }
      }
    },
    "quality_scores": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "rejection_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"split_role": {"enum": ["test", "golden"]}}},
      "then": {"properties": {"allowed_use": {"enum": ["evaluation", "red-team"]}}}
    },
    {
      "if": {"properties": {"asset_kind": {"const": "evaluation-case"}}},
      "then": {"properties": {"allowed_use": {"enum": ["evaluation", "red-team"]}}}
    },
    {
      "if": {"properties": {"split_role": {"const": "red-team"}}},
      "then": {
        "properties": {
          "allowed_use": {"const": "red-team"},
          "trust_zone": {"const": "red-team"}
        }
      }
    },
    {
      "if": {"properties": {"split_role": {"const": "golden"}}},
      "then": {
        "properties": {"trust_zone": {"const": "restricted-evaluation"}}
      }
    },
    {
      "if": {
        "properties": {
          "allowed_use": {
            "enum": [
              "knowledge-index",
              "classifier-training",
              "sft",
              "preference",
              "embedding",
              "reranker"
            ]
          }
        },
        "required": ["allowed_use"]
      },
      "then": {
        "properties": {
          "trust_zone": {"enum": ["quarantine", "candidate", "released"]}
        }
      }
    },
    {
      "if": {
        "properties": {"allowed_use": {"const": "classifier-training"}},
        "required": ["allowed_use"]
      },
      "then": {"properties": {"payload_schema_id": {"const": "vivi-classifier"}}}
    },
    {
      "if": {
        "properties": {"allowed_use": {"const": "preference"}},
        "required": ["allowed_use"]
      },
      "then": {"properties": {"payload_schema_id": {"const": "vivi-preference"}}}
    },
    {
      "if": {
        "properties": {"allowed_use": {"const": "embedding"}},
        "required": ["allowed_use"]
      },
      "then": {"properties": {"payload_schema_id": {"const": "vivi-embedding"}}}
    },
    {
      "if": {
        "properties": {"allowed_use": {"const": "reranker"}},
        "required": ["allowed_use"]
      },
      "then": {"properties": {"payload_schema_id": {"const": "vivi-reranker"}}}
    }
  ]
}
