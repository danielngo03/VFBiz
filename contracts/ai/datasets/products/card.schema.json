{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vfbiz.example/contracts/ai/dataset-card/v1",
  "title": "VFBiz Dataset Card",
  "type": "object",
  "required": [
    "dataset_id",
    "version",
    "title",
    "status",
    "purpose",
    "assistant_profiles",
    "description",
    "owner_role",
    "source_ids",
    "classification",
    "acl_namespaces",
    "retention",
    "split_strategy",
    "known_limitations",
    "review_date"
  ],
  "properties": {
    "dataset_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["candidate", "review", "released", "rejected", "tombstoned"]
    },
    "purpose": {
      "enum": [
        "knowledge",
        "retrieval-evaluation",
        "intent-ood",
        "conversation-quality",
        "tool-evaluation",
        "refusal-safety",
        "red-team",
        "state-resilience",
        "multimodal"
      ]
    },
    "assistant_profiles": {
      "type": "array",
      "items": { "enum": ["public_customer", "authenticated_customer"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "description": { "type": "string", "minLength": 1 },
    "owner_role": { "type": "string", "minLength": 1 },
    "source_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "classification": {
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "acl_namespaces": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "retention": {
      "type": "object",
      "required": ["policy_id", "deletion_method"],
      "properties": {
        "policy_id": { "type": "string", "minLength": 1 },
        "deletion_method": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "split_strategy": {
      "type": "object",
      "required": ["grouping_key", "held_out_before_training"],
      "properties": {
        "grouping_key": { "type": "string", "minLength": 1 },
        "held_out_before_training": { "const": true },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "quality_metrics": { "type": "object" },
    "known_limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "review_date": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
