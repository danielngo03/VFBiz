flowchart TB
  accTitle: Identity, session và data ownership
  accDescr: Keycloak sở hữu authentication, Redis giữ short-lived state, API PostgreSQL giữ business authorization và domain data, AI database giữ knowledge artifacts.

  subgraph Identity["Identity Authority"]
    direction LR
    CustomerRealm["Keycloak Realm<br/>vfbiz-customer"]
    WorkforceRealm["Keycloak Realm<br/>vfbiz-workforce"]
  end

  subgraph Session["Application Session"]
    direction LR
    CustomerBFF["Customer BFF"]
    WorkforceBFF["Workforce BFF"]
    Vault[("Redis Token Vault<br/>TTL · Lease · Fence")]
  end

  subgraph Business["Business Authorities"]
    direction LR
    API["API Authorization Decision"]
    CustomerDB[("Customer · Consent · Garage")]
    WorkforceDB[("Capability · Role · Assignment")]
    MobilityDB[("Vehicle · Charging · Trip")]
  end

  subgraph Knowledge["Knowledge Authorities"]
    direction LR
    Drupal["Drupal<br/>Editorial content"]
    AIDB[("Knowledge · Vector · Evaluation")]
    Object[("Source binary · Artifact")]
  end

  subgraph Enterprise["Enterprise Authorities"]
    direction LR
    PIM["PIM / ERP"]
    CRM["CRM / DMS"]
    CSMS["V-GREEN / CSMS"]
  end

  CustomerBFF --> CustomerRealm
  WorkforceBFF --> WorkforceRealm
  CustomerBFF --> Vault
  WorkforceBFF --> Vault
  CustomerBFF --> API
  WorkforceBFF --> API
  API --> CustomerDB
  API --> WorkforceDB
  API --> MobilityDB
  PIM --> MobilityDB
  CRM --> CustomerDB
  CSMS --> MobilityDB
  Drupal -. "publish event" .-> AIDB
  Object --> AIDB

  Note["Keycloak không sở hữu<br/>business capability"] -.-> WorkforceDB
  Note2["Redis không phải<br/>durable authority"] -.-> Vault

  subgraph Legend["Legend"]
    direction LR
    LI["Identity"]
    LS["Session"]
    LB["Business data"]
    LK["Knowledge"]
  end
  Object ~~~ LI

  classDef customer fill:#78a9ff,stroke:#0056d6,color:#0b1220,stroke-width:2px;
  classDef workforce fill:#65c9bd,stroke:#0f5c55,color:#0b1220,stroke-width:2px;
  classDef platform fill:#f1f4f8,stroke:#344256,color:#142033,stroke-width:2px;
  classDef ai fill:#ffb800,stroke:#344256,color:#0b1220,stroke-width:2px;
  classDef data fill:#d8e0ea,stroke:#202c3d,color:#0b1220,stroke-width:2px;
  classDef external fill:#ffffff,stroke:#98a6b8,color:#344256,stroke-width:2px;
  classDef note fill:#ffffff,stroke:#b42318,color:#b42318,stroke-dasharray:5 5;
  class CustomerRealm,CustomerBFF customer;
  class WorkforceRealm,WorkforceBFF workforce;
  class API platform;
  class Vault,CustomerDB,WorkforceDB,MobilityDB,LS,LB data;
  class Drupal,AIDB,Object,LK ai;
  class PIM,CRM,CSMS external;
  class LI workforce;
  class Note,Note2 note;
