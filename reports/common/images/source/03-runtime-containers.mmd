flowchart TB
  accTitle: Runtime containers và trust boundaries
  accDescr: Clients đi qua BFF hoặc API; API điều phối dữ liệu nghiệp vụ, AI private service, storage và provider adapters.

  subgraph Internet["Internet / User Device"]
    direction LR
    Browser["Browser"]
    Native["Mobile App"]
  end

  subgraph Edge["Experience & Edge Boundary"]
    direction LR
    CDN["CDN / WAF"]
    Drupal["Drupal"]
    BFF["Next.js BFFs"]
    Identity["Keycloak"]
  end

  subgraph Runtime["Application Runtime"]
    direction LR
    API["NestJS API<br/>Authorization · Business State · Orchestration"]
    AI["FastAPI AI<br/>LangGraph · Retrieval · Evaluation"]
  end

  subgraph Data["Data Boundary"]
    direction LR
    APIDB[("API PostgreSQL<br/>PostGIS")]
    AIDB[("AI PostgreSQL<br/>pgvector")]
    Redis[("Redis<br/>Short-lived state")]
    Object[("Object Storage<br/>Source artifacts")]
  end

  subgraph Providers["External Provider Boundary"]
    direction LR
    Enterprise["CRM · DMS · PIM · ERP"]
    Mobility["Maps · V-GREEN · Weather"]
    Models["Model · Embedding · Vision"]
    Channels["Email · SMS · Push"]
  end

  Browser --> CDN
  Native --> CDN
  CDN --> Drupal
  CDN --> BFF
  BFF --> Identity
  Drupal --> API
  BFF --> API
  Native --> API
  API --> AI
  API --> APIDB
  API --> Redis
  AI --> AIDB
  AI --> Redis
  AI --> Object
  API --> Enterprise
  API --> Mobility
  AI --> Models
  API --> Channels

  API -. "outbox/events" .-> AI
  AI -. "proposal/result" .-> API

  subgraph Legend["Legend"]
    direction LR
    LX["Experience"]
    LP["Runtime"]
    LD["Data"]
    LE["External"]
  end
  Channels ~~~ LX

