flowchart TB
  accTitle: Customer Chatbot runtime
  accDescr: Tin nhắn đi qua NestJS Conversation Runtime tới FastAPI LangGraph; retrieval, model và tool proposal không vượt business authority của API.

  Client["Drupal / Portal / Mobile"]

  subgraph APIPlane["NestJS — Business Authority"]
    direction LR
    Edge["Identity · Scope · Quota<br/>Size · Sequence"]
    Inbox[("Conversation Inbox<br/>OCC · Outbox")]
    Tools["Read-only Tool Gateway<br/>Auth · Schema · Anomaly"]
    Handoff["Durable Handoff<br/>Reconnect · Notification"]
  end

  subgraph AIPlane["FastAPI — AI Orchestration"]
    direction LR
    Graph["LangGraph Supervisor"]
    State[("Versioned Checkpoint<br/>Global · Active · Control")]
    Retrieval["Hybrid Retrieval<br/>ACL · Freshness · Citation"]
    Mesh["Model Mesh<br/>Tier · Budget · Fallback"]
    Proposal["Typed Tool Proposal"]
  end

  Sources[("Approved Knowledge")]
  Systems["Business Systems"]
  Human["Nhân viên CSKH"]

  Client --> Edge
  Edge --> Inbox
  Inbox --> Graph
  Graph --> State
  Graph --> Retrieval
  Retrieval --> Sources
  Graph --> Mesh
  Graph --> Proposal
  Proposal --> Tools
  Tools --> Systems
  Graph --> Handoff
  Handoff --> Human
  Graph --> Inbox
  Inbox --> Client

  Guard["Citation hoặc<br/>Refuse / Handoff"] -.-> Graph

  subgraph Legend["Legend"]
    direction LR
    LC["Customer"]
    LA["API authority"]
    LMLEG["AI orchestration"]
    LR["Human recovery"]
  end
  Systems ~~~ LC

