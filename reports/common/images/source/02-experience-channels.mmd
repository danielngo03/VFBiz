flowchart TB
  accTitle: Các kênh trải nghiệm Customer và Workforce
  accDescr: Sơ đồ mô tả audience, channel và authority tương ứng của Drupal, hai portal, mobile và Keycloak.

  subgraph Public["Public Experience"]
    direction LR
    Visitor["Khách vãng lai"] --> Drupal["Drupal<br/>Content · SEO · Discovery"]
  end

  subgraph Customer["Authenticated Customer Experience"]
    direction LR
    CustomerActor["Khách hàng"] --> CustomerPortal["Customer Portal<br/>Account · Garage · Chat"]
    CustomerActor --> Mobile["Mobile<br/>Native journeys"]
    CustomerPortal --> CustomerRealm["Keycloak<br/>vfbiz-customer"]
    Mobile --> CustomerRealm
  end

  subgraph Workforce["Workforce Experience"]
    direction LR
    Employee["Nhân sự"] --> WorkforcePortal["Workforce Portal<br/>Authorization · Support · Knowledge"]
    WorkforcePortal --> WorkforceRealm["Keycloak<br/>vfbiz-workforce"]
  end

  Drupal --> API["API Platform<br/>Business authority"]
  CustomerPortal --> API
  Mobile --> API
  WorkforcePortal --> API
  API --> AI["AI Platform<br/>Private"]

  Note["UI hỗ trợ UX;<br/>API vẫn enforce quyền"] -.-> API

  subgraph Legend["Legend"]
    direction LR
    LC["Customer channel"]
    LW["Workforce channel"]
    LA["Authority"]
  end
  AI ~~~ LC

