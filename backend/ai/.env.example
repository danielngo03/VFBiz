# Local development only. Copy to .env; never commit populated secrets.
# Dataset Factory download credential. Create a fine-grained Hugging Face token
# with read access only, keep it in the ignored `.env`, and rotate it after any
# accidental disclosure. This token authorizes quarantine fetch only; it does
# not grant purpose approval, dataset release, model training, or deployment.
# HF_TOKEN=
HF_HUB_DISABLE_TELEMETRY=1
# Dataset inspection is fail-closed when the ClamAV signature database is
# missing or older than 48 hours in local/CI. Use an absolute path locally.
# VFBIZ_AI_DATASET_CLAMAV_DATABASE=/absolute/path/to/clamav/database

VFBIZ_AI_ENVIRONMENT=development
VFBIZ_AI_SERVICE_NAME=VFBiz AI Platform
VFBIZ_AI_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
VFBIZ_AI_EXPOSE_DOCS=true
GOOGLE_CLOUD_PROJECT=vinfast-503003
GOOGLE_CLOUD_LOCATION=asia-southeast1
# Local development stores only Secret Manager resource IDs here. The actual
# Langfuse credentials remain in Secret Manager and are loaded through ADC.
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY_SECRET_ID=vfbiz-langfuse-public-key-dev
LANGFUSE_SECRET_KEY_SECRET_ID=vfbiz-langfuse-secret-key-dev
LANGFUSE_SECRET_VERSION=1
VFBIZ_AI_DATABASE_URL=postgresql+asyncpg://vfbiz:vfbiz@127.0.0.1:5432/vfbiz_ai
VFBIZ_AI_REDIS_URL=redis://127.0.0.1:6379/2
VFBIZ_AI_GATEWAY_ISSUER=vfbiz-api
VFBIZ_AI_GATEWAY_AUDIENCE=vfbiz-ai
VFBIZ_AI_GATEWAY_JWKS_URL=http://127.0.0.1:8000/api/v1/internal/ai/jwks
# Workload response authenticity. Mount the private PEM from a secret store;
# never put private key material in this file or Git.
# VFBIZ_AI_RESPONSE_SIGNING_KEY_ID=ai-response-2026-01
# VFBIZ_AI_RESPONSE_SIGNING_PRIVATE_KEY_FILE=/absolute/path/to/ai-response-private.pem
VFBIZ_AI_RESPONSE_SIGNING_TTL_SECONDS=30

# Governed semantic routing remains deterministic while disabled. Enabling the
# HTTP adapter only provides deployment coordinates; PostgreSQL's active,
# evidence-verified classifier binding remains the runtime authority.
VFBIZ_AI_SEMANTIC_CLASSIFIER_PROVIDER=disabled
# VFBIZ_AI_SEMANTIC_CLASSIFIER_ENDPOINT=https://classifier.internal.example/v1/route
# VFBIZ_AI_SEMANTIC_CLASSIFIER_ALLOWED_ORIGINS=["https://classifier.internal.example"]
# VFBIZ_AI_SEMANTIC_CLASSIFIER_API_TOKEN=
# VFBIZ_AI_SEMANTIC_CLASSIFIER_ARTIFACT_REF=classifier://vivi/router/v1
# VFBIZ_AI_SEMANTIC_CLASSIFIER_ARTIFACT_SHA256=
VFBIZ_AI_SEMANTIC_CLASSIFIER_TIMEOUT_SECONDS=2
VFBIZ_AI_SEMANTIC_CLASSIFIER_MAX_REQUEST_BYTES=32768
VFBIZ_AI_SEMANTIC_CLASSIFIER_MAX_RESPONSE_BYTES=16384
VFBIZ_AI_SEMANTIC_CLASSIFIER_MAX_CONCURRENCY=16

VFBIZ_AI_GENERATION_PROVIDER=disabled
VFBIZ_AI_EMBEDDING_PROVIDER=disabled
VFBIZ_AI_GENERATION_MODEL=disabled
VFBIZ_AI_EMBEDDING_MODEL=disabled
VFBIZ_AI_EMBEDDING_DIMENSION=8
VFBIZ_AI_EMBEDDING_MAX_ITEMS_PER_REQUEST=64
VFBIZ_AI_EMBEDDING_MAX_INPUT_BYTES_PER_REQUEST=1048576
VFBIZ_AI_EMBEDDING_MAX_INPUT_TOKENS_PER_REQUEST=128000
VFBIZ_AI_EMBEDDING_MAX_CONCURRENCY=16
VFBIZ_AI_EMBEDDING_MAX_RESPONSE_BYTES=8388608
VFBIZ_AI_EMBEDDING_MAX_OUTPUT_ELEMENTS=1048576
VFBIZ_AI_EMBEDDING_INPUT_TEMPLATE_REVISION=identity-v1
VFBIZ_AI_EMBEDDING_QUERY_PREFIX=
VFBIZ_AI_EMBEDDING_DOCUMENT_PREFIX=
VFBIZ_AI_EMBEDDING_CIRCUIT_FAILURE_THRESHOLD=3
VFBIZ_AI_EMBEDDING_CIRCUIT_RECOVERY_SECONDS=30
VFBIZ_AI_EMBEDDING_INPUT_MICROUSD_PER_MILLION_TOKENS=0
VFBIZ_AI_EMBEDDING_FIXED_REQUEST_COST_MICROUSD=0
VFBIZ_AI_SELF_HOSTED_EMBEDDING_BASE_URL=http://127.0.0.1:8080
# VFBIZ_AI_SELF_HOSTED_EMBEDDING_API_TOKEN=
# VFBIZ_AI_SELF_HOSTED_EMBEDDING_TOKENIZER_SHA256=
# VFBIZ_AI_SELF_HOSTED_EMBEDDING_WEIGHTS_SHA256=
# VFBIZ_AI_SELF_HOSTED_EMBEDDING_DEPLOYMENT_SHA256=
VFBIZ_AI_REQUEST_TIMEOUT_SECONDS=30
VFBIZ_AI_MAX_INPUT_TOKENS=16000
VFBIZ_AI_MAX_OUTPUT_TOKENS=1200
VFBIZ_AI_MODEL_POLICY_PROFILE=customer-grounded-v1
VFBIZ_AI_PROMPT_REVISION=customer-grounded-v1
VFBIZ_AI_STRUCTURED_SCHEMA_REVISION=grounded-answer-v2
VFBIZ_AI_MODEL_SAFETY_TIER=customer-factual-v1
VFBIZ_AI_MODEL_RESIDENCY=global
VFBIZ_AI_MAX_RESPONSE_BYTES=262144
VFBIZ_AI_MAX_PROVIDER_CONCURRENCY=32
VFBIZ_AI_INPUT_MICROUSD_PER_MILLION_TOKENS=0
VFBIZ_AI_OUTPUT_MICROUSD_PER_MILLION_TOKENS=0

# Vertex is release-gated and disabled by default. Authentication uses ADC or
# Cloud Run workload identity; never add a service-account key or access token
# here. Enabling it requires an approved release manifest, data-control
# evidence, pricing revision and exact model allowlist.
VFBIZ_AI_VERTEX_PROJECT_ID=vinfast-503003
VFBIZ_AI_VERTEX_LOCATION=asia-southeast1
VFBIZ_AI_VERTEX_GENERATION_MODEL_ALLOWLIST=[]
VFBIZ_AI_VERTEX_EMBEDDING_MODEL_ALLOWLIST=[]
VFBIZ_AI_VERTEX_RETENTION_POLICY=standard
# VFBIZ_AI_VERTEX_DATA_CONTROLS_APPROVAL_REFERENCE=
# VFBIZ_AI_VERTEX_DATA_CONTROLS_APPROVAL_SHA256=
# VFBIZ_AI_VERTEX_PRICING_REVISION=

# OpenAI remains inactive while both provider settings are disabled. When an approved release
# enables it, pin an exact model snapshot and fill the secret only in ignored
# .env/Secret Manager. `store=false` does not itself grant ZDR/MAM.
VFBIZ_AI_OPENAI_GENERATION_MODEL_ALLOWLIST=[]
VFBIZ_AI_OPENAI_EMBEDDING_MODEL_ALLOWLIST=[]
# Generation and embedding use independent capability identities. The active
# release manifest is resolved from PostgreSQL authority, never from an env hash.
# VFBIZ_AI_GENERATION_OPENAI_API_KEY=
# VFBIZ_AI_GENERATION_OPENAI_BASE_URL=https://api.openai.com/v1
# VFBIZ_AI_GENERATION_OPENAI_PROJECT_ID=
# VFBIZ_AI_GENERATION_OPENAI_ORGANIZATION_ID=
# VFBIZ_AI_GENERATION_OPENAI_RETENTION_POLICY=standard
# VFBIZ_AI_GENERATION_OPENAI_APPROVAL_REFERENCE=
# VFBIZ_AI_GENERATION_OPENAI_APPROVAL_SHA256=
# VFBIZ_AI_EMBEDDING_OPENAI_API_KEY=
# VFBIZ_AI_EMBEDDING_OPENAI_BASE_URL=https://api.openai.com/v1
# VFBIZ_AI_EMBEDDING_OPENAI_PROJECT_ID=
# VFBIZ_AI_EMBEDDING_OPENAI_ORGANIZATION_ID=
# VFBIZ_AI_EMBEDDING_OPENAI_RETENTION_POLICY=standard
# VFBIZ_AI_EMBEDDING_OPENAI_APPROVAL_REFERENCE=
# VFBIZ_AI_EMBEDDING_OPENAI_APPROVAL_SHA256=

# Governed knowledge ingestion is disabled by default. The synthetic-local
# profile is local/test only and requires all three paths plus the AI database.
VFBIZ_AI_KNOWLEDGE_INGESTION_PROFILE=disabled
# VFBIZ_AI_KNOWLEDGE_SYNTHETIC_SOURCE_ROOT=/absolute/path/to/approved-fixtures
# VFBIZ_AI_KNOWLEDGE_ARTIFACT_ROOT=/absolute/path/to/local-artifacts
# VFBIZ_AI_KNOWLEDGE_SOURCE_MAP_PATH=/absolute/path/to/source-map.json
VFBIZ_AI_KNOWLEDGE_SCANNER_REVISION=deterministic-v1
VFBIZ_AI_KNOWLEDGE_POLICY_REVISION=policy-v1
VFBIZ_AI_KNOWLEDGE_EMBEDDING_DIMENSION=8
# GCP ingestion requires separate immutable staging and Document AI output
# buckets. The output bucket is dedicated to the reconciler so its list
# permission is bounded by the bucket boundary rather than a fragile prefix
# condition. Keep this profile disabled until the synthetic manifest and
# database/runtime identities are reviewed.
# VFBIZ_AI_KNOWLEDGE_GCP_PROJECT_ID=vinfast-503003
# VFBIZ_AI_KNOWLEDGE_GCP_LOCATION=asia-southeast1
# VFBIZ_AI_KNOWLEDGE_GCP_DOCUMENT_PROCESSOR_ID=
# VFBIZ_AI_KNOWLEDGE_GCP_DOCUMENT_PROCESSOR_REVISION=
# VFBIZ_AI_KNOWLEDGE_GCP_INPUT_BUCKETS=["vinfast-503003-intake-dev"]
# VFBIZ_AI_KNOWLEDGE_GCP_STAGING_BUCKET=vinfast-503003-derived-dev
# VFBIZ_AI_KNOWLEDGE_GCP_OUTPUT_BUCKET=vinfast-503003-ocr-output-dev
