# Local development only. Copy to .env; never commit populated secrets.
VFBIZ_AI_ENVIRONMENT=development
VFBIZ_AI_SERVICE_NAME=VFBiz AI Platform
VFBIZ_AI_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
VFBIZ_AI_EXPOSE_DOCS=true
VFBIZ_AI_DATABASE_URL=postgresql+asyncpg://vfbiz:vfbiz@127.0.0.1:5432/vfbiz_ai
VFBIZ_AI_REDIS_URL=redis://127.0.0.1:6379/2
VFBIZ_AI_GATEWAY_ISSUER=http://127.0.0.1:8000
VFBIZ_AI_GATEWAY_AUDIENCE=vfbiz-ai-internal
VFBIZ_AI_GATEWAY_JWKS_URL=http://127.0.0.1:8000/.well-known/jwks.json
VFBIZ_AI_PROVIDER=disabled
VFBIZ_AI_CHAT_MODEL=disabled
VFBIZ_AI_EMBEDDING_MODEL=disabled
VFBIZ_AI_REQUEST_TIMEOUT_SECONDS=30
VFBIZ_AI_MAX_OUTPUT_TOKENS=1200

# Provider credentials belong only in ignored .env or a real secret manager.
# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
