model Cart {
  id                String     @id @default(uuid()) @db.Uuid
  customerProfileId String     @db.Uuid
  status            String     @db.VarChar(40)
  currency          String     @db.Char(3)
  version           Int        @default(1)
  expiresAt         DateTime   @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(6)
  items             CartItem[]

  @@index([customerProfileId, status])
  @@map("cart")
}

model CartItem {
  id         String @id @default(uuid()) @db.Uuid
  cartId     String @db.Uuid
  cart       Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productRef String @db.VarChar(160)
  quantity   Int
  unitAmount BigInt
  metadata   Json

  @@index([cartId])
  @@map("cart_item")
}

model OrderProjection {
  id                String   @id @default(uuid()) @db.Uuid
  customerProfileId String   @db.Uuid
  externalOrderRef  String   @unique @db.VarChar(160)
  status            String   @db.VarChar(40)
  currency          String   @db.Char(3)
  totalAmount       BigInt
  sourceRevision    String   @db.VarChar(160)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  @@index([customerProfileId, createdAt])
  @@map("order_projection")
}
