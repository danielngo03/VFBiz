model OwnerVehicleAssociation {
  id                 String    @id @default(uuid()) @db.Uuid
  customerProfileId  String    @db.Uuid
  externalVehicleRef String    @db.VarChar(255)
  state              String    @db.VarChar(40)
  verifiedAt         DateTime? @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([customerProfileId, externalVehicleRef])
  @@map("owner_vehicle_association")
}

model ServiceAppointmentProjection {
  id                 String   @id @default(uuid()) @db.Uuid
  customerProfileId  String   @db.Uuid
  externalVehicleRef String   @db.VarChar(255)
  providerRef        String?  @db.VarChar(160)
  status             String   @db.VarChar(40)
  scheduledAt        DateTime @db.Timestamptz(6)
  sourceRevision     String   @db.VarChar(160)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  @@index([customerProfileId, scheduledAt])
  @@map("service_appointment_projection")
}
