# Local development only. Copy to .env; never commit populated secrets.
NODE_ENV=development
VFBIZ_API_HOST=127.0.0.1
VFBIZ_API_PORT=8000
VFBIZ_API_DOCS_ENABLED=true
# Internal, read-only Scalar reference. Production validation forces this off.
VFBIZ_WORKFORCE_API_DOCS_ENABLED=true
VFBIZ_DATABASE_URL=postgresql://vfbiz:vfbiz@127.0.0.1:5434/vfbiz
VFBIZ_REDIS_URL=redis://127.0.0.1:6379/1
VFBIZ_CUSTOMER_OIDC_ISSUER=http://127.0.0.1:8080/realms/vfbiz-customer
VFBIZ_CUSTOMER_OIDC_JWKS_URI=http://127.0.0.1:8080/realms/vfbiz-customer/protocol/openid-connect/certs
VFBIZ_CUSTOMER_OIDC_AUDIENCE=vfbiz-customer-api
VFBIZ_CUSTOMER_OIDC_AUTHORIZED_PARTIES=vfbiz-customer-bff,vfbiz-mobile
VFBIZ_CUSTOMER_CIAM_ADMIN_CLIENT_ID=vfbiz-customer-identity-bridge
VFBIZ_CUSTOMER_CIAM_ADMIN_CLIENT_SECRET=
VFBIZ_WORKFORCE_OIDC_ISSUER=http://127.0.0.1:8080/realms/vfbiz-workforce
VFBIZ_WORKFORCE_OIDC_JWKS_URI=http://127.0.0.1:8080/realms/vfbiz-workforce/protocol/openid-connect/certs
VFBIZ_WORKFORCE_OIDC_AUDIENCE=vfbiz-workforce-api
VFBIZ_WORKFORCE_OIDC_AUTHORIZED_PARTIES=vfbiz-workforce-bff
VFBIZ_LOG_LEVEL=info

# Opt-in only. `npm run seed:local --workspace @vfbiz/api` sets this flag for
# one process and refuses non-loopback hosts or databases other than `vfbiz`.
VFBIZ_ALLOW_SYNTHETIC_SEED=false
