# Local development only. Copy to .env; never commit populated secrets.
NODE_ENV=development
VFBIZ_API_HOST=127.0.0.1
VFBIZ_API_PORT=8000
VFBIZ_API_DOCS_ENABLED=true
# Internal, read-only Scalar reference. Production validation forces this off.
VFBIZ_WORKFORCE_API_DOCS_ENABLED=true
# Empty means no proxy is trusted and X-Forwarded-For is ignored. In a proxied
# environment, list only the exact private load-balancer/reverse-proxy CIDRs.
# The trusted proxy must overwrite/sanitize inbound forwarded headers.
# Wildcards and /0 networks are rejected; never list public client networks.
VFBIZ_API_TRUSTED_PROXY_CIDRS=
VFBIZ_DATABASE_URL=postgresql://vfbiz:vfbiz@127.0.0.1:5434/vfbiz
VFBIZ_REDIS_URL=redis://127.0.0.1:6379/1
VFBIZ_CUSTOMER_OIDC_ISSUER=http://127.0.0.1:8080/realms/vfbiz-customer
VFBIZ_CUSTOMER_OIDC_JWKS_URI=http://127.0.0.1:8080/realms/vfbiz-customer/protocol/openid-connect/certs
VFBIZ_CUSTOMER_OIDC_AUDIENCE=vfbiz-customer-api
VFBIZ_CUSTOMER_OIDC_AUTHORIZED_PARTIES=vfbiz-customer-bff,vfbiz-mobile
VFBIZ_CUSTOMER_CIAM_ADMIN_CLIENT_ID=vfbiz-customer-identity-bridge
VFBIZ_CUSTOMER_CIAM_ADMIN_CLIENT_SECRET=
VFBIZ_WORKFORCE_OIDC_ISSUER=http://127.0.0.1:8080/realms/vfbiz-workforce
VFBIZ_WORKFORCE_OIDC_JWKS_URI=http://127.0.0.1:8080/realms/vfbiz-workforce/protocol/openid-connect/certs
VFBIZ_WORKFORCE_OIDC_AUDIENCE=vfbiz-workforce-api
VFBIZ_WORKFORCE_OIDC_AUTHORIZED_PARTIES=vfbiz-workforce-bff

# Required in staging/production. Fetch these values from the runtime secret
# manager; never commit key material. Key material is standard Base64 encoding
# of exactly 32 random bytes. Example shape:
# {"keys":[{"id":"conversation-2026-01","material":"<base64-32-byte-key>"}]}
VFBIZ_CONVERSATION_CONTENT_ACTIVE_KEY_ID=
VFBIZ_CONVERSATION_CONTENT_KEYRING=

# Disabled until the private AI runtime and an approved signing key secret are
# available. The API never forwards a customer/workforce bearer token to AI.
VFBIZ_INTERNAL_AI_ENABLED=false
# Keep dispatch disabled until the FastAPI graph release is activated and its
# response-revision contract has passed staging acceptance.
VFBIZ_INTERNAL_AI_DISPATCH_ENABLED=false
# Development example only. Staging/production require HTTPS and an exact
# service-host allowlist enforced together with private network ingress.
VFBIZ_INTERNAL_AI_BASE_URL=
VFBIZ_INTERNAL_AI_ALLOWED_HOSTS=
VFBIZ_INTERNAL_AI_REQUEST_TIMEOUT_MS=15000
VFBIZ_INTERNAL_AI_RETRY_BUDGET=1
VFBIZ_INTERNAL_AI_ASSERTION_ISSUER=vfbiz-api
VFBIZ_INTERNAL_AI_ASSERTION_AUDIENCE=vfbiz-ai
VFBIZ_INTERNAL_AI_ASSERTION_TTL_SECONDS=30
VFBIZ_INTERNAL_AI_ASSERTION_ACTIVE_KEY_ID=
# Metadata only; key bytes stay in a secret-mounted absolute file. Up to three
# current/next/retiring keys may overlap by kid during rotation. Never place a
# PEM, Keycloak key, customer secret or real path credential in this file.
# {"keys":[{"alg":"ES256","kid":"api-ai-2026-01","privateKeyFile":"/run/secrets/vfbiz-ai-es256.pem"}]}
VFBIZ_INTERNAL_AI_ASSERTION_KEYRING=
# Base64-encoded random key (at least 32 bytes), environment-specific.
VFBIZ_INTERNAL_AI_SUBJECT_PSEUDONYMIZATION_KEY=

VFBIZ_LOG_LEVEL=info

# Opt-in only. `npm run seed:local --workspace @vfbiz/api` sets this flag for
# one process and refuses non-loopback hosts or databases other than `vfbiz`.
VFBIZ_ALLOW_SYNTHETIC_SEED=false
