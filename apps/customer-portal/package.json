{
  "name": "@vfbiz/customer-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VFBiz authenticated customer web foundation",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit && npm run test:component",
    "test:unit": "tsx --test tests/unit/*.spec.ts",
    "test:component": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:required": "node scripts/verify-e2e.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-alert-dialog": "^1.1.21",
    "@radix-ui/react-slot": "^1.3.1",
    "@vfbiz/api-client": "0.1.0",
    "@vfbiz/design-tokens": "0.1.0",
    "@vfbiz/portal-session-core": "0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.10.0",
    "jose": "^6.2.4",
    "next": "16.2.12",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.82.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  }
}
