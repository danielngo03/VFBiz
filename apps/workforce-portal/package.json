{
  "name": "@vfbiz/workforce-portal",
  "version": "0.1.0",
  "private": true,
  "description": "VFBiz workforce portal built with Next.js App Router",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:required": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.1",
    "@vfbiz/design-tokens": "0.1.0",
    "@vfbiz/portal-session-core": "0.1.0",
    "@vfbiz/workforce-api-client": "0.1.0",
    "ioredis": "^5.10.0",
    "jose": "^6.2.4",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.2.11",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
