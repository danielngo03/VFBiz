WORKFORCE_API_BASE_URL=http://127.0.0.1:8000
WORKFORCE_OIDC_ISSUER=http://127.0.0.1:8080/realms/vfbiz-workforce
WORKFORCE_OIDC_CLIENT_ID=vfbiz-workforce-bff
WORKFORCE_OIDC_CLIENT_SECRET=replace-with-local-keycloak-client-secret
WORKFORCE_OIDC_REDIRECT_URI=http://localhost:3002/api/auth/callback
WORKFORCE_REDIS_URL=redis://127.0.0.1:6379/2
# Generate with: openssl rand -base64 32
WORKFORCE_TOKEN_VAULT_KEY=replace-with-32-byte-base64-key
WORKFORCE_SESSION_COOKIE_NAME=vfbiz-workforce-session
WORKFORCE_SESSION_MAX_AGE_SECONDS=28800
WORKFORCE_SESSION_IDLE_TIMEOUT_SECONDS=1800
# Enable only behind a trusted proxy that strips client-supplied forwarding headers.
WORKFORCE_TRUST_PROXY_HEADERS=false
