{
  "primitive": {
    "color": {
      "white": "#ffffff",
      "slate25": "#f7f9fc",
      "slate50": "#f1f4f8",
      "slate200": "#d8e0ea",
      "slate400": "#98a6b8",
      "slate500": "#5c6979",
      "slate700": "#344256",
      "slate800": "#202c3d",
      "slate900": "#142033",
      "slate950": "#0b1220",
      "teal300": "#65c9bd",
      "teal600": "#0f5c55",
      "teal700": "#0b4742",
      "blue300": "#78a9ff",
      "blue600": "#0056d6",
      "blue700": "#0047b2",
      "red600": "#b42318",
      "amber400": "#ffb800"
    },
    "radius": {
      "small": "0.5rem",
      "medium": "0.875rem",
      "large": "1.25rem"
    },
    "space": {
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "6": "1.5rem",
      "8": "2rem"
    },
    "fontSize": {
      "caption": "0.75rem",
      "body": "1rem",
      "title": "1.25rem",
      "display": "2rem"
    },
    "lineHeight": {
      "caption": "1rem",
      "body": "1.5rem",
      "title": "1.75rem",
      "display": "2.5rem"
    },
    "touchTarget": {
      "minimum": "2.75rem",
      "comfortable": "3rem"
    },
    "icon": {
      "small": "1rem",
      "medium": "1.5rem",
      "large": "2rem"
    },
    "motionDuration": {
      "instant": "0ms",
      "quick": "120ms",
      "standard": "220ms",
      "deliberate": "360ms"
    },
    "motionEasing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.2, 0, 0, 1.2)"
    },
    "elevation": {
      "flat": "0",
      "raised": "2",
      "overlay": "8"
    }
  },
  "semantic": {
    "surface": "{color.white}",
    "surfaceSubtle": "{color.slate50}",
    "text": "{color.slate900}",
    "textMuted": "{color.slate500}",
    "border": "{color.slate200}",
    "danger": "{color.red600}",
    "focus": "{color.amber400}",
    "radiusSmall": "{radius.small}",
    "radiusMedium": "{radius.medium}",
    "radiusLarge": "{radius.large}",
    "$dark": {
      "surface": "{color.slate800}",
      "surfaceSubtle": "{color.slate900}",
      "text": "{color.white}",
      "textMuted": "{color.slate400}",
      "border": "{color.slate700}"
    }
  },
  "customer": {
    "accent": "{color.teal600}",
    "accentStrong": "{color.teal700}",
    "onAccent": "{color.white}",
    "canvas": "{color.slate25}",
    "$dark": {
      "accent": "{color.teal300}",
      "accentStrong": "{color.teal300}",
      "onAccent": "{color.slate950}",
      "canvas": "{color.slate950}"
    }
  },
  "workforce": {
    "accent": "{color.blue600}",
    "accentStrong": "{color.blue700}",
    "onAccent": "{color.white}",
    "canvas": "{color.slate50}",
    "$dark": {
      "accent": "{color.blue300}",
      "accentStrong": "{color.blue300}",
      "onAccent": "{color.slate950}",
      "canvas": "{color.slate950}"
    }
  }
}
