{
  "$schema": "../contracts/governance/organization.schema.json",
  "version": 9,
  "runtime": {
    "maxWriterLanes": 3,
    "maxSpawnDepth": 1,
    "maxSameCauseAttempts": 2,
    "maxReviewFixCycles": 2,
    "maxCapsuleTokens": 1500,
    "claimTtlMinutes": 120,
    "leaseTtlMinutes": 30,
    "heartbeatMinutes": 5,
    "maxLeaseRenewals": 3,
    "maxSameCauseHandoffs": 2
  },
  "controlPlane": {
    "dispatcherMode": "single-writer",
    "bootstrapState": "git-common-dir",
    "multiMachineReady": false,
    "exclusiveResourceClasses": [
      "agent-organization-registry",
      "public-contract",
      "database-migration",
      "dependency-lockfile",
      "drupal-config",
      "ai-source-registry",
      "ai-knowledge-release-registry",
      "ai-dataset-registry",
      "ai-evaluation-suite-registry"
    ],
    "sharedPathResources": [
      {
        "path": "package-lock.json",
        "resource": "dependency-lockfile"
      },
      {
        "path": "backend/api/prisma/migrations",
        "resource": "database-migration"
      },
      {
        "path": "backend/ai/migrations",
        "resource": "database-migration"
      },
      {
        "path": "backend/ai/pyproject.toml",
        "resource": "dependency-lockfile"
      },
      {
        "path": "backend/ai/uv.lock",
        "resource": "dependency-lockfile"
      },
      {
        "path": "contracts/openapi",
        "resource": "public-contract"
      },
      {
        "path": "contracts/asyncapi",
        "resource": "public-contract"
      },
      {
        "path": "packages/api-client/src/generated.ts",
        "resource": "public-contract"
      },
      {
        "path": "drupal/config",
        "resource": "drupal-config"
      },
      {
        "path": "drupal/recipes",
        "resource": "drupal-config"
      },
      {
        "path": "backend/ai/dataset-specs",
        "resource": "ai-source-registry"
      },
      {
        "path": "backend/ai/dataset-specs/evaluation",
        "resource": "ai-evaluation-suite-registry"
      },
      {
        "path": ".agents/organization.json",
        "resource": "agent-organization-registry"
      }
    ]
  },
  "humanAuthorities": [
    "executive-sponsor",
    "product-owner",
    "product-manager",
    "business-owner",
    "design-lead",
    "identity-platform-owner",
    "architect",
    "security-owner",
    "privacy-owner",
    "legal-owner",
    "data-owner",
    "engineering-lead",
    "release-owner"
  ],
  "supportingHumanRoles": [
    "product-analyst",
    "business-analyst",
    "data-steward",
    "quality-lead"
  ],
  "roles": [
    {
      "id": "orchestrator",
      "description": "Own one work item, route bounded context and coordinate direct specialists without implementing approval decisions.",
      "mode": "read-only",
      "authority": "coordination",
      "capabilities": ["read", "search", "shell"],
      "maxTurns": 24,
      "trigger": ["controlled", "parallel", "cross-system"]
    },
    {
      "id": "explorer",
      "description": "Perform bounded read-heavy repository or documentation research and return a concise evidence summary.",
      "mode": "read-only",
      "authority": "advisory",
      "capabilities": ["read", "search", "shell"],
      "maxTurns": 18,
      "trigger": ["discovery", "research", "noisy-analysis"],
      "modelTier": "light"
    },
    {
      "id": "implementer",
      "description": "Implement one approved outcome inside declared paths and return observed evidence.",
      "mode": "scoped-write",
      "authority": "implementation",
      "capabilities": ["read", "search", "write", "shell"],
      "maxTurns": 30,
      "trigger": ["fast", "bounded", "controlled", "parallel"],
      "modelTier": "deep"
    },
    {
      "id": "reviewer-verifier",
      "description": "Verify acceptance and review correctness, regression and maintainability without editing.",
      "mode": "read-only",
      "authority": "evidence",
      "capabilities": ["read", "search", "shell"],
      "maxTurns": 20,
      "trigger": ["behavior-change", "bounded-review", "controlled-review"],
      "modelTier": "critical"
    },
    {
      "id": "risk-reviewer",
      "description": "Review security, privacy, data, AI, contracts, rights and operations without accepting risk.",
      "mode": "read-only",
      "authority": "advisory",
      "capabilities": ["read", "search", "shell"],
      "maxTurns": 20,
      "trigger": ["controlled"],
      "modelTier": "critical"
    },
    {
      "id": "integrator",
      "description": "Integrate sealed disjoint lanes, resolve mechanical conflicts and run cross-lane checks without approving release.",
      "mode": "scoped-write",
      "authority": "integration",
      "capabilities": ["read", "search", "write", "shell"],
      "maxTurns": 24,
      "trigger": ["parallel", "integration"],
      "modelTier": "standard"
    },
    {
      "id": "dataset-source-researcher",
      "description": "Research dataset and source candidates read-only, record provenance and license evidence, and never download or accept rights.",
      "mode": "read-only",
      "authority": "advisory",
      "capabilities": ["read", "search", "shell"],
      "maxTurns": 18,
      "trigger": ["dataset-source"],
      "modelTier": "standard"
    },
    {
      "id": "synthetic-dataset-builder",
      "description": "Generate one schema-valid synthetic candidate shard from approved inputs without production PII or release authority.",
      "mode": "scoped-write",
      "authority": "implementation",
      "capabilities": ["read", "search", "write", "shell"],
      "maxTurns": 30,
      "trigger": ["synthetic-dataset"],
      "modelTier": "standard"
    },
    {
      "id": "dataset-quality-reviewer",
      "description": "Independently verify dataset integrity, schema, lineage, duplication, contamination, PII, bias and coverage; return content-addressed evidence without editing, approving or releasing it.",
      "mode": "read-only",
      "authority": "evidence",
      "capabilities": ["read", "search", "shell"],
      "maxTurns": 24,
      "trigger": ["dataset-release", "synthetic-dataset-review"],
      "modelTier": "critical"
    },
    {
      "id": "golden-domain-reviewer",
      "description": "Independently verify Dataset Product and Golden-case domain correctness, VinFast semantics, ViVi voice, tool/state behavior and ambiguity; return evidence without adjudicating or releasing it.",
      "mode": "read-only",
      "authority": "evidence",
      "capabilities": ["read", "search", "shell"],
      "maxTurns": 24,
      "trigger": [
        "dataset-release",
        "golden-case-review",
        "golden-suite-release"
      ],
      "modelTier": "critical"
    }
  ],
