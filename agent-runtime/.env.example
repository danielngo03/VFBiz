# Agent Runtime mặc định fail-closed. Sao chép file này thành `.env`, không
# commit `.env`, và chỉ bật live provider sau khi `doctor` báo cấu hình hợp lệ.

# Model provider: `openai` hoặc `openai-compatible`.
VFBIZ_AGENT_RUNTIME_LIVE_ENABLED=false
VFBIZ_AGENT_RUNTIME_PROVIDER=openai
VFBIZ_AGENT_RUNTIME_API_KEY=
VFBIZ_AGENT_RUNTIME_BASE_URL=
VFBIZ_AGENT_RUNTIME_API_MODE=responses

# Model mặc định cho mọi role. Có thể override riêng bằng các biến được comment.
VFBIZ_AGENT_RUNTIME_MODEL=gpt-5.5
# VFBIZ_AGENT_RUNTIME_MODEL_ORCHESTRATOR=
# VFBIZ_AGENT_RUNTIME_MODEL_EXPLORER=
# VFBIZ_AGENT_RUNTIME_MODEL_IMPLEMENTER=
# VFBIZ_AGENT_RUNTIME_MODEL_REVIEWER_VERIFIER=
# VFBIZ_AGENT_RUNTIME_MODEL_RISK_REVIEWER=
# VFBIZ_AGENT_RUNTIME_MODEL_INTEGRATOR=

# Bắt buộc khi live provider được bật. Dùng giá công bố của đúng provider/model.
VFBIZ_AGENT_RUNTIME_INPUT_USD_PER_1M=
VFBIZ_AGENT_RUNTIME_OUTPUT_USD_PER_1M=

# Khóa base64 của đúng 32 byte, ví dụ: openssl rand -base64 32
VFBIZ_AGENT_RUNTIME_STATE_KEY=

# Các capability nhạy cảm đều tắt mặc định.
VFBIZ_AGENT_RUNTIME_CODEX_ENABLED=false
VFBIZ_AGENT_RUNTIME_TRACE_ENABLED=false

# Vận hành local một máy.
VFBIZ_AGENT_RUNTIME_WATCH_INTERVAL_MS=2000
# VFBIZ_AGENT_RUNTIME_STATE_DIR=
# VFBIZ_AGENT_RUNTIME_FIXTURE_WORKTREE=
# VFBIZ_AGENT_RUNTIME_SCOPE_BASE=

# Với endpoint OpenAI-compatible, đổi tối thiểu:
# VFBIZ_AGENT_RUNTIME_PROVIDER=openai-compatible
# VFBIZ_AGENT_RUNTIME_BASE_URL=https://provider.example/v1
# VFBIZ_AGENT_RUNTIME_API_MODE=chat-completions
# VFBIZ_AGENT_RUNTIME_MODEL=<provider-model-id>
