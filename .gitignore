# Local database/export artifacts. Versioned migrations remain tracked.
*.bak
*.dump
*.sqlite
*.sqlite3

# Drupal runtime and Composer-scaffolded files. Configuration, custom code and
# recipes stay versioned; generated core/contrib code and site-local state do not.
drupal/.phpunit.cache/
drupal/web/autoload.php
drupal/web/autoload_runtime.php
drupal/web/core/
drupal/web/modules/contrib/
drupal/web/profiles/contrib/
drupal/web/themes/contrib/
drupal/web/sites/*/files/
drupal/web/sites/*/private/
drupal/web/sites/*/settings.php
drupal/web/sites/*/settings.local.php
drupal/web/sites/*/services.yml

local-data/
.agent-state/
private-data/
artifacts/
docs/work/capsules/

# Personal setup runbooks for the repository owner and local coding agents.
# These may describe private infrastructure choices and must never be published.
guides/
